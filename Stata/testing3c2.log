. 
. di as text _n "  r(design)    = " as result "`r(design)'"   as text "   want 
> HAD"

  r(design)    = HAD   want HAD

. di as text    "  r(had_case)  = " as result "`r(had_case)'" as text "   want 
> none"
  r(had_case)  = none   want none

. di as text    "  r(had_tie)   = " as result r(had_tie)      as text "   want 
> 0"
  r(had_tie)   = 0   want 0

. di as text    "  r(n_stayers) = " as result r(n_stayers)    as text "   want 
